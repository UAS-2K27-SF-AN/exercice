{% extends 'base.html.twig' %}
{% block title %}Détails de l'article{% endblock %}
{% block body %}
    <h1>Détails de l'article</h1>

    <p><strong>ID :</strong> {{ article.id }}</p>
    <p><strong>Titre :</strong> {{ article.title }}</p>
    <p><strong>Auteur :</strong> {{ article.author }}</p>
    <p><strong>Date :</strong> {{ article.createdAt|date('d/m/Y') }}</p>
    <p><strong>Contenu :</strong></p>
    <div style="background: white; padding: 10px; width: fit-content; min-width: 250px; border: 1px solid #777;">
        {{ article.content|nl2br }}
    </div>

    <p style="margin-top: 15px;">
        <a href="{{ path('article_edit', {id: article.id}) }}">Modifier</a>
        &nbsp;|&nbsp;
        <a href="{{ path('article_index') }}">Retour aux articles</a>
    </p>
{% endblock %}
