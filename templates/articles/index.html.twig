{% extends 'base.html.twig' %}
{% block title %}Articles{% endblock %}
{% block body %}
    <h1>Articles</h1>

    <p>
        <a href="{{ path('article_add') }}">+ Nouvel article</a>
    </p>

    {% if articles is empty %}
        <p>Aucun article trouvé.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.id }}</td>
                        <td>{{ article.title }}</td>
                        <td>{{ article.author }}</td>
                        <td>{{ article.createdAt|date('d/m/Y') }}</td>
                        <td class="actions">
                            <a href="{{ path('article_show', {id: article.id}) }}">Voir</a>
                            <a href="{{ path('article_edit', {id: article.id}) }}">Modifier</a>
                            <a href="{{ path('article_delete', {id: article.id}) }}" onclick="return confirm('supprimer cet article {{ article.id }}');">Supprimer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
